generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURN_EXPECTED
  RETURNED
  INSPECTION
  QUARANTINED
}

enum Grade {
  REFURBISHED
  GRADE_A
  GRADE_B
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  AUTHORIZED
  IN_TRANSIT
  RECEIVED
  APPROVED
  REJECTED
  REFUNDED
}

enum SellerLedgerEntryType {
  SALE_CREDIT
  PAYOUT
  RETURN_DEBIT
  SHIPPING_DEBIT
  ADJUSTMENT
}

enum SellerLedgerEntryStatus {
  PENDING
  POSTED
  SETTLED
  VOID
}

enum VendorReturnStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  RECEIVED_BY_VENDOR
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(CUSTOMER)
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller?
  orders    Order[]
}

model Seller {
  id          String @id @default(cuid())
  userId      String @unique
  displayName String
  verified    Boolean @default(false)
  status      SellerStatus @default(PENDING)
  user        User @relation(fields: [userId], references: [id])
  listings    SellerListing[]
  ledgerEntries SellerLedgerEntry[]
  vendorReturns VendorReturn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id     String @id @default(cuid())
  name   String @unique
  models CatalogModel[]
}

model Brand {
  id     String @id @default(cuid())
  name   String @unique
  models CatalogModel[]
}

model CatalogModel {
  id         String @id @default(cuid())
  categoryId String
  brandId    String
  name       String
  slug       String @unique
  category   Category @relation(fields: [categoryId], references: [id])
  brand      Brand @relation(fields: [brandId], references: [id])
  variants   Variant[]
}

model Variant {
  id       String @id @default(cuid())
  modelId  String
  storage  String
  color    String
  model    CatalogModel @relation(fields: [modelId], references: [id])
  listings SellerListing[]

  @@unique([modelId, storage, color])
}

model SellerListing {
  id             String @id @default(cuid())
  sellerId       String
  variantId      String
  status         ListingStatus @default(DRAFT)
  carrier        String
  grade          Grade
  warrantyMonths Int
  priceCents     Int
  seller         Seller @relation(fields: [sellerId], references: [id])
  variant        Variant @relation(fields: [variantId], references: [id])
  inventory      InventoryUnit[]
  orderLines     OrderLine[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InventoryUnit {
  id           String @id @default(cuid())
  listingId    String
  imei         String? @unique
  serialNumber String? @unique
  batteryHealth Int?
  status       InventoryStatus @default(AVAILABLE)
  orderLineId  String?
  reservedUntil DateTime?
  listing      SellerListing @relation(fields: [listingId], references: [id])
  orderLine    OrderLine? @relation(fields: [orderLineId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id          String @id @default(cuid())
  customerId  String
  status      OrderStatus @default(PENDING_PAYMENT)
  totalCents  Int
  email       String
  firstName   String
  lastName    String
  address     String
  city        String
  postalCode  String
  country     String
  carrier     String?
  trackingNumber String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  customer    User @relation(fields: [customerId], references: [id])
  lines       OrderLine[]
  payments    Payment[]
  returnStatus      ReturnStatus?
  returnRequestedAt DateTime?
  returnAuthorizedAt DateTime?
  returnReceivedAt  DateTime?
  returnInspectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  listingId      String
  quantity       Int @default(1)
  unitPriceCents Int
  order          Order @relation(fields: [orderId], references: [id])
  listing        SellerListing @relation(fields: [listingId], references: [id])
  inventory      InventoryUnit[]
  ledgerEntries  SellerLedgerEntry[]
  vendorReturns  VendorReturn[]
}


model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?       @unique
  amountCents       Int
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}


model SellerLedgerEntry {
  id          String                  @id @default(cuid())
  sellerId    String
  orderLineId String?
  type        SellerLedgerEntryType
  status      SellerLedgerEntryStatus @default(POSTED)
  amountCents Int
  currency    String                  @default("USD")
  note        String?
  seller      Seller                  @relation(fields: [sellerId], references: [id])
  orderLine   OrderLine?              @relation(fields: [orderLineId], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([sellerId, status])
  @@index([orderLineId])
}

model VendorReturn {
  id             String             @id @default(cuid())
  sellerId       String
  orderLineId    String
  status         VendorReturnStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  receivedAt     DateTime?
  seller         Seller             @relation(fields: [sellerId], references: [id])
  orderLine      OrderLine          @relation(fields: [orderLineId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([sellerId, status])
  @@index([orderLineId])
}
